{
  "name": "@toshon-jennings/lighthouse",
  "version": "0.3.7",
  "main": "electron/main.js",
  "bin": {
    "lh": "bin/lh.js"
  },
  "files": [
    "bin",
    "lib",
    "electron",
    "src",
    "vite.config.ts",
    "build/icon.png",
    "AGENTS.md"
  ],
  "scripts": {
    "dev": "vite --port 5189 --strictPort",
    "electron": "concurrently -k -s first \"npm:dev\" \"wait-on http://localhost:5189 && NODE_ENV=development electron .\"",
    "start": "npm run electron",
    "build": "vite build",
    "dist": "npm run build && electron-builder --mac dmg && $HOME/.config/agent-rules/bin/fix-dmg-background.sh release/Lighthouse-$npm_package_version.dmg"
  },
  "dependencies": {
    "commander": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.1",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "tech.toshon.lighthouse",
    "productName": "Lighthouse",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "artifactName": "${productName}-${version}.${ext}",
      "background": "build/background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 100,
      "contents": [
        {
          "x": 140,
          "y": 225,
          "type": "file"
        },
        {
          "x": 400,
          "y": 225,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
